<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg_primary">

    <!-- Top bar: CinemaTrack (movies) <-> DiziTrack (series), and the language button -->
    <LinearLayout android:id="@+id/topBar"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@color/bg_surface" android:paddingHorizontal="12dp">
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnModeMovie"
            android:layout_width="wrap_content" android:layout_height="36dp"
            android:text="@string/brand_cinema" android:textSize="13sp" android:textStyle="bold"
            android:textAllCaps="false" android:stateListAnimator="@null"
            android:paddingHorizontal="14dp" android:minWidth="0dp"/>
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnModeTv"
            android:layout_width="wrap_content" android:layout_height="36dp"
            android:text="@string/brand_dizi" android:textSize="13sp" android:textStyle="bold"
            android:textAllCaps="false" android:stateListAnimator="@null"
            android:paddingHorizontal="14dp" android:minWidth="0dp"
            android:layout_marginStart="8dp"/>
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnLang"
            android:layout_width="wrap_content" android:layout_height="36dp"
            android:textSize="13sp" android:textStyle="bold"
            android:textColor="@color/text_secondary" android:textAllCaps="false"
            android:background="@drawable/btn_secondary" android:stateListAnimator="@null"
            android:paddingHorizontal="14dp" android:minWidth="0dp"
            android:contentDescription="@string/language_button_description"/>
        <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/btnSettings"
            android:layout_width="36dp" android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_settings" android:tint="@color/text_secondary"
            android:background="@drawable/btn_secondary" android:scaleType="center"
            android:contentDescription="@string/settings_button_description"/>
    </LinearLayout>

    <FrameLayout android:id="@+id/fragmentContainer"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent" android:layout_height="60dp"
        android:background="@drawable/bottom_nav_bg"
        app:menu="@menu/bottom_nav"
        app:labelVisibilityMode="labeled"
        app:itemIconSize="22dp"/>
</LinearLayout>
