<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="20dp">
    <TextView android:id="@+id/tvAccountName"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="18sp" android:textStyle="bold" android:textColor="@color/text_primary"/>
    <TextView android:id="@+id/tvAccountEmail"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:layout_marginBottom="18dp"
        android:textSize="13sp" android:textColor="@color/text_secondary"/>
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnChangeName"
        android:layout_width="match_parent" android:layout_height="44dp"
        android:text="@string/account_change_name" android:textSize="14sp"
        android:textColor="@color/text_primary" android:textAllCaps="false"
        android:background="@drawable/btn_secondary" android:stateListAnimator="@null"/>
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnAccountSignOut"
        android:layout_width="match_parent" android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:text="@string/sign_out" android:textSize="14sp"
        android:textColor="@color/text_primary" android:textAllCaps="false"
        android:background="@drawable/btn_secondary" android:stateListAnimator="@null"/>
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnAccountDelete"
        android:layout_width="match_parent" android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:text="@string/delete_account" android:textSize="14sp"
        android:textColor="@color/accent_red" android:textAllCaps="false"
        android:background="@drawable/btn_secondary" android:stateListAnimator="@null"/>
</LinearLayout>
