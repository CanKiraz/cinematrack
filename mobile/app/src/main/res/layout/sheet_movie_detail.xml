<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingBottom="32dp">

        <!-- Handle -->
        <View android:layout_width="40dp" android:layout_height="4dp"
            android:background="@color/border" android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp" android:layout_marginBottom="16dp"/>

        <!-- Poster + info -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingHorizontal="20dp"
            android:layout_marginBottom="16dp">
            <ImageView android:id="@+id/ivPoster"
                android:layout_width="100dp" android:layout_height="150dp"
                android:scaleType="centerCrop" android:background="@drawable/card_bg"
                android:layout_marginEnd="16dp"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical">
                <TextView android:id="@+id/tvTitle"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="18sp" android:textStyle="bold" android:textColor="@color/text_primary"
                    android:layout_marginBottom="8dp"/>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="6dp">
                    <TextView android:id="@+id/tvYear"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="13sp" android:textColor="@color/text_secondary"
                        android:layout_marginEnd="10dp"/>
                    <TextView android:id="@+id/tvRuntime"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="13sp" android:textColor="@color/text_secondary"
                        android:layout_marginEnd="10dp"/>
                    <TextView android:id="@+id/tvRating"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="13sp" android:textStyle="bold"
                        android:textColor="@color/accent_yellow"/>
                </LinearLayout>
                <TextView android:id="@+id/tvGenres"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="?attr/ctAccentLight"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Overview -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/overview_label" android:textSize="11sp" android:textStyle="bold"
            android:textColor="@color/text_secondary" android:letterSpacing="0.1"
            android:layout_marginHorizontal="20dp" android:layout_marginBottom="8dp"/>
        <TextView android:id="@+id/tvOverview"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="14sp" android:textColor="@color/text_primary"
            android:lineSpacingExtra="4dp" android:paddingHorizontal="20dp"
            android:layout_marginBottom="16dp"/>

        <!-- Streaming -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/available_in_turkey" android:textSize="11sp" android:textStyle="bold"
            android:textColor="@color/text_secondary" android:letterSpacing="0.1"
            android:layout_marginHorizontal="20dp" android:layout_marginBottom="8dp"/>
        <LinearLayout android:id="@+id/llStreaming"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingHorizontal="20dp"
            android:layout_marginBottom="20dp">
            <TextView android:id="@+id/tvStreamingStatus"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/providers_checking" android:textSize="13sp"
                android:textColor="@color/text_secondary"/>
        </LinearLayout>

        <!-- Action buttons -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingHorizontal="20dp">

            <!-- Watchlist mode: Mark Watched (green) + Remove (red) -->
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnWatched"
                android:layout_width="match_parent" android:layout_height="44dp"
                android:text="@string/sheet_mark_watched"
                android:textColor="#ffffff" android:textSize="16sp" android:textStyle="bold"
                android:background="@drawable/btn_green"
                android:stateListAnimator="@null"
                android:layout_marginBottom="10dp"
                android:elevation="2dp"
                android:visibility="gone"
                android:textAllCaps="false"/>

            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnRemove"
                android:layout_width="match_parent" android:layout_height="44dp"
                android:text="@string/sheet_remove"
                android:textColor="#ffffff" android:textSize="16sp" android:textStyle="bold"
                android:background="@drawable/btn_danger"
                android:stateListAnimator="@null"
                android:elevation="2dp"
                android:visibility="gone"
                android:textAllCaps="false"/>

            <!-- Search mode: Add to Watchlist (blue) + Mark Watched (green) -->
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnAdd"
                android:layout_width="match_parent" android:layout_height="44dp"
                android:text="@string/sheet_add"
                android:textColor="#ffffff" android:textSize="16sp" android:textStyle="bold"
                android:background="@drawable/btn_primary"
                android:stateListAnimator="@null"
                android:layout_marginBottom="10dp"
                android:elevation="2dp"
                android:visibility="gone"
                android:textAllCaps="false"/>

            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnAddWatched"
                android:layout_width="match_parent" android:layout_height="44dp"
                android:text="@string/sheet_mark_watched"
                android:textColor="#ffffff" android:textSize="16sp" android:textStyle="bold"
                android:background="@drawable/btn_green"
                android:stateListAnimator="@null"
                android:elevation="2dp"
                android:visibility="gone"
                android:textAllCaps="false"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
