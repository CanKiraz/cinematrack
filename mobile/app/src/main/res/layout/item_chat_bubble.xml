<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:paddingHorizontal="12dp"
    android:paddingVertical="3dp">
    <FrameLayout android:id="@+id/bubbleCard"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:maxWidth="260dp" android:padding="12dp">
        <TextView android:id="@+id/tvText"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/text_primary" android:textSize="14sp"
            android:lineSpacingExtra="3dp"/>
    </FrameLayout>
</LinearLayout>
