{
  "name": "cinematrack-firebase",
  "private": true,
  "version": "1.0.0",
  "description": "Firestore security rules for CinemaTrack, with emulator tests",
  "type": "module",
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project demo-cinematrack \"vitest run\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-cinematrack",
    "deploy:rules": "firebase deploy --only firestore:rules"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.34.0",
    "vitest": "^5.0.4"
  }
}
