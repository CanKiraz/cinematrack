# Copy to .env to override defaults. All values are optional.

# Keys saved in the app's Settings win over these. (Temporary: these go away once the API proxy lands.)
MAIN_VITE_TMDB_KEY=
MAIN_VITE_GEMINI_KEY=

# Firebase. Leave unset to use the official CinemaTrack backend.
# Set these to run against your own Firebase project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
