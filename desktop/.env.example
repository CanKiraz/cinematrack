# Copy to .env to override defaults. Everything here is optional: the app works out of the box
# against the official CinemaTrack backend, and nobody needs a TMDB or Gemini key.

# The CinemaTrack API (worker/). Point it at `npm run dev` of the worker to develop against a local one.
MAIN_VITE_API_URL=

# Firebase. Leave unset to use the official CinemaTrack project.
# Set these to run against your own Firebase project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
